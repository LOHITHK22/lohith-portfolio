# Base URL of the deployed site, used for metadataBase, canonical URLs, and the
# Open Graph / Twitter share image. Set this to your production Vercel URL
# (or custom domain) after deployment.
#
# Example: https://lohithkovuri.dev  or  https://lohith-portfolio.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-deployment-url.vercel.app

# --- AI Pitch guided-tour narration (dev-time only, never shipped to the browser) ---
# Used ONLY by `npm run generate:tour-audio`, a one-time local script that
# pre-renders data/guidedTour.ts into static MP3 files under public/audio/.
# The deployed site just plays those static files — this key is never read
# at runtime and never bundled into client code. Get a key at elevenlabs.io.
ELEVENLABS_API_KEY=

# Optional: any voice ID from your ElevenLabs voice library. Defaults to the
# "Adam" premade voice (pNInz6obpgDQGcFmaJgB) if left unset.
ELEVENLABS_VOICE_ID=
